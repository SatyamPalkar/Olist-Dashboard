    <worksheet name="Ful Ship Limit">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">LATE RATE WHEN THE SELLER MISSES THE SHIPPING LIMIT</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">Hand-off after the seller's shipping limit date. Association, not proven cause.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order fulfilment (delivered)" name="federated.olistfulfilment"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistfulfilment">
            <column caption="Dispatch Label" datatype="string" name="[F_Days_Label_D]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([dispatch_days]), 1)) + &quot; days&quot;"/>
            </column>
            <column caption="Transit Label" datatype="string" name="[F_Days_Label_T]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([transit_days]), 1)) + &quot; days&quot;"/>
            </column>
            <column caption="Avg Seller Dispatch (days)" datatype="real" default-format="n0.0" name="[F_Dispatch]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([dispatch_days])"/>
            </column>
            <column caption="Late Share (colour)" datatype="real" default-format="p0%" name="[F_Late_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([is_late])"/>
            </column>
            <column caption="Late Rate" datatype="real" default-format="p0.0%" name="[F_Late_Rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Missed Limit Share (colour)" datatype="real" default-format="p0%" name="[F_Miss_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([missed_ship_limit])"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[F_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([order_id])"/>
            </column>
            <column caption="Delivery Outcome" datatype="string" name="[F_Outcome]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [is_late] = 1 THEN &quot;Late orders&quot; ELSE &quot;On-time orders&quot; END"/>
            </column>
            <column caption="Avg Review" datatype="real" default-format="n0.00" name="[F_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Seller Shipping" datatype="string" name="[F_Ship_Label]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [missed_ship_limit] = 1 THEN &quot;Shipped after limit&quot; ELSE &quot;Shipped within limit&quot; END"/>
            </column>
            <column caption="Shipping Label" datatype="string" name="[F_Ship_Lbl]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% late · &quot; + STR(ROUND(COUNT([is_late]) / 1000, 1)) + &quot;K orders&quot;"/>
            </column>
            <column caption="Shipping Flag Usable" datatype="integer" name="[F_Ship_Valid]" role="dimension" type="quantitative">
              <calculation class="tableau" formula="IF NOT ISNULL([missed_ship_limit]) AND NOT ISNULL([is_late]) THEN 1 ELSE 0 END"/>
            </column>
            <column caption="Avg Carrier Transit (days)" datatype="real" default-format="n0.0" name="[F_Transit]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([transit_days])"/>
            </column>
            <column caption="Timing Usable" datatype="integer" name="[F_Valid]" role="dimension" type="quantitative">
              <calculation class="tableau" formula="IF [timing_valid] = 1 AND NOT ISNULL([is_late]) THEN 1 ELSE 0 END"/>
            </column>
            <column caption="Region" datatype="string" name="[customer_region]" role="dimension" type="nominal"/>
            <column caption="Customer State" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Delivery Days" datatype="real" default-format="n0.0" name="[delivery_days]" role="measure" type="quantitative"/>
            <column caption="Seller Dispatch Days" datatype="real" default-format="n0.0" name="[dispatch_days]" role="measure" type="quantitative"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
            <column caption="Missed Shipping Limit" datatype="integer" name="[missed_ship_limit]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Review Score" datatype="integer" name="[review_score]" role="measure" type="quantitative"/>
            <column caption="Sellers in Order" datatype="integer" name="[seller_count]" role="measure" type="quantitative"/>
            <column caption="Timing Valid" datatype="integer" name="[timing_valid]" role="dimension" type="quantitative"/>
            <column caption="Carrier Transit Days" datatype="real" default-format="n0.0" name="[transit_days]" role="measure" type="quantitative"/>
            <column-instance column="[F_Ship_Label]" derivation="None" name="[none:F_Ship_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[F_Ship_Valid]" derivation="None" name="[none:F_Ship_Valid:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[F_Dispatch]" derivation="User" name="[usr:F_Dispatch:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[F_Late_Rate]" derivation="User" name="[usr:F_Late_Rate:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[F_Miss_Code]" derivation="User" name="[usr:F_Miss_Code:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[F_Orders]" derivation="User" name="[usr:F_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[F_Ship_Lbl]" derivation="User" name="[usr:F_Ship_Lbl:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.olistfulfilment].[none:F_Ship_Valid:qk]" included-values="in-range">
            <min>1</min>
            <max>1</max>
          </filter>
          <slices>
            <column>[federated.olistfulfilment].[none:F_Ship_Valid:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
            <format attr="font-size" value="9"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="cols" value="false"/>
            <format attr="display-field-labels" scope="rows" value="false"/>
          </style-rule>
          <style-rule element="axis">
            <format attr="display" class="0" field="[federated.olistfulfilment].[usr:F_Late_Rate:qk]" scope="cols" value="false"/>
            <encoding attr="space" class="0" field="[federated.olistfulfilment].[usr:F_Late_Rate:qk]" field-type="quantitative" max="0.66" min="0" range-type="fixed" scope="cols" type="space"/>
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.olistfulfilment].[none:F_Ship_Label:nk]" value="124"/>
          </style-rule>
          <style-rule element="mark">
            <encoding attr="color" field="[federated.olistfulfilment].[usr:F_Miss_Code:qk]" max="1" min="0" type="custom-interpolated">
              <color-palette custom="true" name="" type="ordered-sequential">
                <color>#3fc1e8</color>
                <color>#e8467c</color>
              </color-palette>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <color column="[federated.olistfulfilment].[usr:F_Miss_Code:qk]"/>
              <text column="[federated.olistfulfilment].[usr:F_Ship_Lbl:nk]"/>
              <tooltip column="[federated.olistfulfilment].[usr:F_Orders:qk]"/>
              <tooltip column="[federated.olistfulfilment].[usr:F_Dispatch:qk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">&lt;[federated.olistfulfilment].[none:F_Ship_Label:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Late rate: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistfulfilment].[usr:F_Late_Rate:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistfulfilment].[usr:F_Orders:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Avg seller dispatch (days): </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistfulfilment].[usr:F_Dispatch:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">Shipping limit = latest shipping_limit_date of the order's items</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold="true" fontcolor="#f2f5f8" fontsize="9">&lt;[federated.olistfulfilment].[usr:F_Ship_Lbl:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="size" value="0.5"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.olistfulfilment].[none:F_Ship_Label:nk]</rows>
        <cols>[federated.olistfulfilment].[usr:F_Late_Rate:qk]</cols>
      </table>
