              <zone fixed-size="564" h="67143" id="10" is-fixed="true" type-v2="text" w="18056" x="0" y="32857">
                <formatted-text>
                  <run bold="true" fontcolor="#3fc1e8" fontsize="9">KEY TAKEAWAYS</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">WHEN</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Mar 2018: 19%+ late in every region (South 19.4%, Southeast 19.2%).</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">WHERE</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Geography amplifies it: NE 36.3%, North 39.2% in Mar 2018; NE 14.4% vs South 7.1% overall.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">NOT THE DRIVER</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Category: 22 large categories sit at 5.5-9.8% late; states span 5.0-23.9%.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">CATEGORY EXCEPTION</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Office Furniture: slowest (20.6 days) and lowest-rated (3.64) large category.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">RETENTION</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">First order late: 3.19% repeat vs 4.04% on time (cohort before Mar 2018). Association.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">INSTALMENTS</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">37% of card orders use 4+ instalments. Order value rises with term: R$101 (1x) to R$333 (7-10x).</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run fontcolor="#8a97a6" fontsize="7">Source: Olist public data → PostgreSQL warehouse → CSV extracts (one grain per chart). Figures verified 2026-11-18.</run>
                </formatted-text>
                <zone-style>
                  <format attr="border-style" value="none"/>
                  <format attr="border-width" value="0"/>
                  <format attr="margin" value="0"/>
                  <format attr="padding" value="16"/>
                  <format attr="background-color" value="#0a1119"/>
                </zone-style>
              </zone>
              <zone-style>
                <format attr="border-style" value="none"/>
                <format attr="border-width" value="0"/>
                <format attr="margin" value="0"/>
                <format attr="padding" value="0"/>
                <format attr="background-color" value="#0a1119"/>
              </zone-style>
            </zone>
            <zone fixed-size="1180" h="100000" id="11" is-fixed="true" param="vert" type-v2="layout-flow" w="81944" x="18056" y="0">
              <zone fixed-size="62" h="7381" id="12" is-fixed="true" type-v2="text" w="81389" x="18333" y="476">
                <formatted-text>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="13">Late delivery is a network-wide timing shock, amplified by geography, not by product category</run>
                  <run>Æ
</run>
                  <run fontcolor="#8a97a6" fontsize="8">Mar 2018: every region was 19%+ late (Northeast 36%, North 39%). States span 5.0-23.9% late; large categories only 5.5-9.8%. Measured on delivered orders; associations, not proven causes.</run>
                </formatted-text>
                <zone-style>
                  <format attr="border-style" value="none"/>
                  <format attr="border-width" value="0"/>
                  <format attr="margin" value="5"/>
                  <format attr="padding" value="12"/>
                  <format attr="background-color" value="#18222f"/>
                </zone-style>
              </zone>
              <zone fixed-size="238" h="28333" id="13" is-fixed="true" name="Diag Heatmap" w="81389" x="18333" y="7857">
