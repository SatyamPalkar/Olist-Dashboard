        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <text column="[federated.olistorders].[usr:Calc_KPI_AOV:nk]"/>
              <text column="[federated.olistorders].[usr:Calc_KPI_Repeat:nk]"/>
              <text column="[federated.olistorders].[usr:Calc_KPI_Days:nk]"/>
              <text column="[federated.olistorders].[usr:Calc_KPI_Freight:nk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">SECONDARY METRICS</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">AOV = (price + freight) / delivered orders. Repeat = unique customers with 2+ delivered orders / all unique customers. Delivery time = purchase to customer delivery, days. Freight share = freight / order value.</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold="true" fontcolor="#8a97a6" fontsize="8">AVG ORDER VALUE</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#f2f5f8" fontsize="12">&lt;[federated.olistorders].[usr:Calc_KPI_AOV:nk]&gt;</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#8a97a6" fontsize="8">REPEAT CUSTOMERS</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#f2f5f8" fontsize="12">&lt;[federated.olistorders].[usr:Calc_KPI_Repeat:nk]&gt;</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#8a97a6" fontsize="8">AVG DELIVERY TIME</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#f2f5f8" fontsize="12">&lt;[federated.olistorders].[usr:Calc_KPI_Days:nk]&gt;</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#8a97a6" fontsize="8">FREIGHT SHARE</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#f2f5f8" fontsize="12">&lt;[federated.olistorders].[usr:Calc_KPI_Freight:nk]&gt;</run>
              </formatted-text>
            </customized-label>
