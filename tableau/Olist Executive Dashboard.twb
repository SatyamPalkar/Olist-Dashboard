              <tooltip column="[federated.olistcustomers].[usr:CU_Customers:qk]"/>
              <tooltip column="[federated.olistcustomers].[usr:CU_Repeaters:qk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">&lt;[federated.olistcustomers].[none:CU_First:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Repeat rate (2+ delivered orders): </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistcustomers].[usr:CU_Repeat:qk]&gt;</run>
                <run>Æ
</run>
