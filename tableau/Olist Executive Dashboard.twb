            <encoding attr="space" class="0" field="[federated.olistorders].[none:purchase_month:qk]" field-type="quantitative" major-origin="#2017-01-01#" major-spacing="3.0" major-units="months" max="#2018-08-16#" min="#2016-12-17#" range-type="fixed" scope="cols" type="space"/>
            <format attr="text-format" field="[federated.olistorders].[none:purchase_month:qk]" value="*mmm yy"/>
            <format attr="display" class="0" field="[federated.olistorders].[none:purchase_month:qk]" scope="cols" value="false"/>
