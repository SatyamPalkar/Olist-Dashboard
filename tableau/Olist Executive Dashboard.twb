              <zone fixed-size="564" h="67143" id="10" is-fixed="true" type-v2="text" w="18056" x="0" y="32857">
                <formatted-text>
                  <run bold="true" fontcolor="#3fc1e8" fontsize="9">KEY TAKEAWAYS</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">1  GROWTH</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Jan-Aug 2018 sales +141% vs 2017; flat at R$0.84-0.98M a month since Mar 2018.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">2  LOGISTICS STRAIN</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Late rate more than doubled (4.2% to 9.4%), peaking in Feb-Mar 2018.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">3  LATENESS HURTS RATINGS</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">4.3 stars when early vs ~1.7 when 8+ days late.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">4  CONCENTRATION</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">SP = 38% of sales; top 10 categories = 62%.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">5  REGIONAL RISK</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Northeast 14.3% late vs ~7% South/Southeast; RJ 13.5% at scale.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">6  RETENTION GAP</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Only 3.0% of customers ordered twice.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run bold="true" fontcolor="#f2f5f8" fontsize="8">7  PAYMENTS</run>
                  <run>Æ
</run>
                  <run fontcolor="#c3ccd6" fontsize="8">Credit card 78.5% of payment value, boleto 18.0%.</run>
                  <run>Æ
</run>
                  <run>Æ
</run>
                  <run fontcolor="#8a97a6" fontsize="7">Source: Olist public data → PostgreSQL warehouse → CSV extracts (one grain per chart). Figures verified 2026-11-18.</run>
                </formatted-text>
