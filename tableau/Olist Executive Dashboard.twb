            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">AVG REVIEW SCORE</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">Average review score (1-5) of delivered orders that have a review. Delta compares Jan-Aug 2018 with Jan-Aug 2017.</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold="true" fontcolor="#8a97a6" fontsize="9">AVG REVIEW SCORE</run>
