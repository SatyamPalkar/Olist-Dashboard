            <column-instance column="[K_Orders]" derivation="User" name="[usr:K_Orders:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[K_Review]" derivation="User" name="[usr:K_Review:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[K_Share]" derivation="User" name="[usr:K_Share:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <computed-sort column="[federated.olistcards].[none:installment_band:nk]" direction="ASC" using="[federated.olistcards].[min:band_order:qk]"/>
