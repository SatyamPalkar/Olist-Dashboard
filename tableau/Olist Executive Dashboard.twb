    <worksheet name="Diag Instalments">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">CREDIT-CARD INSTALMENTS</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">74,302 delivered card orders; band = max instalments on the order's card payments. Review and late rate: association only.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Credit-card orders (delivered)" name="federated.olistcards"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistcards">
            <column caption="AOV" datatype="real" default-format="c&quot;R$&quot;#,##0" name="[K_AOV]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([order_value])"/>
            </column>
            <column caption="Avg Instalments" datatype="real" default-format="n0.0" name="[K_Inst]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([card_installments])"/>
            </column>
            <column caption="Share Label" datatype="string" name="[K_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * COUNT([order_id]) / MIN({FIXED : COUNT([order_id])}), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="Late" datatype="real" default-format="p0.0%" name="[K_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[K_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([order_id])"/>
            </column>
            <column caption="Review" datatype="real" default-format="n0.00" name="[K_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Share of Card Orders" datatype="real" default-format="p0.0%" name="[K_Share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([order_id]) / MIN({FIXED : COUNT([order_id])})"/>
            </column>
            <column caption="Band Order" datatype="integer" name="[band_order]" role="dimension" type="ordinal"/>
            <column caption="Card Instalments" datatype="integer" name="[card_installments]" role="measure" type="quantitative"/>
            <column caption="Card Payment Rows" datatype="integer" name="[card_rows]" role="measure" type="quantitative"/>
            <column caption="Term" datatype="string" name="[installment_band]" role="dimension" type="nominal"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
