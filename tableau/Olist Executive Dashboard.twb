            <format attr="display" class="0" field="[federated.olistcustomers].[usr:CU_Repeat:qk]" scope="rows" value="false"/>
            <encoding attr="space" class="0" field="[federated.olistcustomers].[usr:CU_Repeat:qk]" field-type="quantitative" max="0.055" min="0" range-type="fixed" scope="rows" type="space"/>
          </style-rule>
