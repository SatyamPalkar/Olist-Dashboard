            <column caption="Seller" datatype="string" name="[seller_short]" role="dimension" type="nominal"/>
            <column caption="State" datatype="string" name="[seller_state]" role="dimension" type="nominal"/>
            <column caption="Timing Valid" datatype="integer" name="[timing_valid]" role="dimension" type="quantitative"/>
            <column caption="Carrier Transit Days" datatype="real" default-format="n0.0" name="[transit_days]" role="measure" type="quantitative"/>
            <column-instance column="[seller_id]" derivation="Attribute" name="[attr:seller_id:nk]" pivot="key" type="nominal"/>
            <column-instance column="[seller_excess_rank]" derivation="None" name="[none:seller_excess_rank:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[seller_short]" derivation="None" name="[none:seller_short:nk]" pivot="key" type="nominal"/>
            <column-instance column="[seller_state]" derivation="None" name="[none:seller_state:nk]" pivot="key" type="nominal"/>
            <column-instance column="[S_Dispatch]" derivation="User" name="[usr:S_Dispatch:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[S_Excess]" derivation="User" name="[usr:S_Excess:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Excess_Label]" derivation="User" name="[usr:S_Excess_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[S_Late_Rate]" derivation="User" name="[usr:S_Late_Rate:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[S_Missed]" derivation="User" name="[usr:S_Missed:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[S_Orders]" derivation="User" name="[usr:S_Orders:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[S_Review]" derivation="User" name="[usr:S_Review:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[S_Sales]" derivation="User" name="[usr:S_Sales:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Transit]" derivation="User" name="[usr:S_Transit:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <computed-sort column="[federated.olistsellers].[none:seller_short:nk]" direction="DESC" using="[federated.olistsellers].[usr:S_Excess:qk]"/>
          <filter class="quantitative" column="[federated.olistsellers].[none:seller_excess_rank:qk]" included-values="in-range">
            <min>1</min>
            <max>15</max>
          </filter>
          <slices>
            <column>[federated.olistsellers].[none:seller_excess_rank:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
            <format attr="font-size" value="9"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.olistsellers].[usr:S_Excess:qk]" scope="cols" value="Excess late orders"/>
            <encoding attr="space" class="0" field="[federated.olistsellers].[usr:S_Excess:qk]" field-type="quantitative" max="112" min="0" range-type="fixed" scope="cols" type="space"/>
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.olistsellers].[none:seller_short:nk]" value="70"/>
            <format attr="width" field="[federated.olistsellers].[none:seller_state:nk]" value="44"/>
            <format attr="width" field="[federated.olistsellers].[usr:S_Orders:ok]" value="54"/>
            <format attr="width" field="[federated.olistsellers].[usr:S_Late_Rate:ok]" value="66"/>
            <format attr="width" field="[federated.olistsellers].[usr:S_Missed:ok]" value="80"/>
            <format attr="width" field="[federated.olistsellers].[usr:S_Dispatch:ok]" value="78"/>
            <format attr="width" field="[federated.olistsellers].[usr:S_Review:ok]" value="74"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <text column="[federated.olistsellers].[usr:S_Excess_Label:nk]"/>
              <tooltip column="[federated.olistsellers].[attr:seller_id:nk]"/>
              <tooltip column="[federated.olistsellers].[usr:S_Sales:qk]"/>
              <tooltip column="[federated.olistsellers].[usr:S_Transit:qk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">&lt;[federated.olistsellers].[attr:seller_id:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Seller-orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Orders:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Late rate: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Late_Rate:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Excess late orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Excess:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Missed shipping limit: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Missed:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Avg dispatch (days): </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Dispatch:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Avg transit (days): </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Transit:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Avg review: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Review:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Seller sales: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistsellers].[usr:S_Sales:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">Late flag and review are order-level; shared by every seller in the order</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#c3ccd6" fontsize="8">&lt;[federated.olistsellers].[usr:S_Excess_Label:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-color" value="#e8467c"/>
                <format attr="size" value="0.45"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.olistsellers].[none:seller_short:nk] / [federated.olistsellers].[none:seller_state:nk] / [federated.olistsellers].[usr:S_Orders:ok] / [federated.olistsellers].[usr:S_Late_Rate:ok] / [federated.olistsellers].[usr:S_Missed:ok] / [federated.olistsellers].[usr:S_Dispatch:ok] / [federated.olistsellers].[usr:S_Review:ok])</rows>
        <cols>[federated.olistsellers].[usr:S_Excess:qk]</cols>
      </table>
      <simple-id uuid="{7D80A407-86FC-51D8-8FD6-4BAFB83BC72F}"/>
    </worksheet>
    <worksheet name="Action States">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">STATE EXCEPTION QUEUE</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">21 states with 300+ delivered orders, ranked by excess late orders. Select a state to filter the trend.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Orders (delivered)" name="federated.olistorders"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistorders">
            <column caption="Action Label" datatype="string" name="[Calc_Action_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF([Calc_Excess_Late] &gt;= 0, &quot;+&quot;, &quot;&quot;) + STR(INT(ROUND([Calc_Excess_Late], 0)))"/>
            </column>
            <column caption="Avg Delivery Days" datatype="real" default-format="n0.0" name="[Calc_Avg_Days]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([delivery_days])"/>
            </column>
            <column caption="Avg Review" datatype="real" default-format="n0.00" name="[Calc_Avg_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Delta Late" datatype="string" name="[Calc_D_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% to &quot; + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Orders" datatype="string" name="[Calc_D_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) &gt;= COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) / COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Delta Review" datatype="string" name="[Calc_D_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END) &gt;= AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; to &quot; + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Sales" datatype="string" name="[Calc_D_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) / SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Excess Late Orders" datatype="real" default-format="n+#,##0;-#,##0" name="[Calc_Excess_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) - COUNT([is_late]) * MIN([Calc_Network_Late])"/>
            </column>
            <column caption="Gap (pp)" datatype="real" default-format="n+0.0;-0.0" name="[Calc_Gap_pp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="100 * ([Calc_Late_Rate] - MIN([Calc_Network_Late]))"/>
            </column>
            <column caption="KPI Avg Order Value" datatype="string" name="[Calc_KPI_AOV]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([order_value]) / COUNTD([order_id]), 2))"/>
            </column>
            <column caption="KPI Avg Delivery Days" datatype="string" name="[Calc_KPI_Days]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([delivery_days]), 1)) + &quot; days&quot;"/>
            </column>
            <column caption="KPI Freight Share" datatype="string" name="[Calc_KPI_Freight]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([freight_charges]) / SUM([order_value]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Late Delivery Rate" datatype="string" name="[Calc_KPI_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Orders" datatype="string" name="[Calc_KPI_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(COUNTD([order_id]) / 1000, 1)) + &quot;K&quot;"/>
            </column>
            <column caption="KPI Repeat Customers" datatype="string" name="[Calc_KPI_Repeat]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * COUNTD(IF [is_repeat_customer] = 1 THEN [customer_unique_id] END) / COUNTD([customer_unique_id]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Avg Review" datatype="string" name="[Calc_KPI_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; / 5&quot;"/>
            </column>
            <column caption="KPI Merchandise Sales" datatype="string" name="[Calc_KPI_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot;"/>
            </column>
            <column caption="Late Share (colour)" datatype="real" default-format="p0%" name="[Calc_Late_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([is_late])"/>
            </column>
            <column caption="Late Orders" datatype="integer" default-format="n#,##0" name="[Calc_Late_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late])"/>
            </column>
            <column caption="Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Late_Rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Late-order Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[Calc_Late_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [is_late] = 1 THEN [merchandise_sales] END)"/>
            </column>
            <column caption="Month Index" datatype="integer" name="[Calc_Month_Index]" role="measure" type="quantitative">
              <calculation class="tableau" formula="YEAR([purchase_month]) * 100 + MONTH([purchase_month])"/>
            </column>
            <column caption="Month" datatype="string" name="[Calc_Month_Label]" role="dimension" type="nominal">
              <calculation class="tableau" formula="LEFT(DATENAME('month', [purchase_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([purchase_month])), 2)"/>
            </column>
            <column caption="Network Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Network_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED : SUM([is_late]) / COUNT([is_late])}"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[Calc_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([order_id])"/>
            </column>
            <column caption="Delivery Outcome" datatype="string" name="[Calc_Outcome]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([is_late]) THEN &quot;Unknown&quot; ELSEIF [is_late] = 1 THEN &quot;Late&quot; ELSE &quot;On time or early&quot; END"/>
            </column>
            <column caption="Review Label" datatype="string" name="[Calc_Review_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; ★&quot;"/>
            </column>
            <column caption="Sales (R$M)" datatype="real" default-format="c&quot;R$&quot;#,##0.00&quot;M&quot;" name="[Calc_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([merchandise_sales]) / 1000000"/>
            </column>
            <column caption="State Late Label" datatype="string" name="[Calc_State_Late_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% · &quot; + IIF(COUNT([is_late]) &gt;= 1000, STR(ROUND(COUNT([is_late]) / 1000, 1)) + &quot;K&quot;, STR(COUNT([is_late]))) + &quot; orders&quot;"/>
            </column>
            <column caption="State Sales Label" datatype="string" name="[Calc_State_Sales_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot; + &quot; · &quot; + STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% late&quot;"/>
            </column>
            <column caption="Tier" datatype="string" name="[Calc_Tier]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF [Calc_Gap_pp] &gt;= 3 AND [Calc_Excess_Late] &gt;= 50 THEN &quot;Priority&quot; ELSEIF [Calc_Gap_pp] &gt;= 1 THEN &quot;Watch&quot; ELSE &quot;Monitor&quot; END"/>
            </column>
            <column caption="Priority Tier Code" datatype="integer" name="[Calc_Tier_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_Tier] = &quot;Priority&quot; THEN 3 ELSEIF [Calc_Tier] = &quot;Watch&quot; THEN 2 ELSE 1 END"/>
            </column>
            <column caption="Region" datatype="string" name="[customer_region]" role="dimension" type="nominal"/>
            <column caption="State Code" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Customer Unique ID" datatype="string" name="[customer_unique_id]" role="dimension" type="nominal"/>
            <column caption="Days vs Estimate" datatype="integer" name="[days_vs_estimate]" role="measure" type="quantitative"/>
            <column caption="Delivery Days" datatype="real" name="[delivery_days]" role="measure" type="quantitative"/>
            <column caption="Delivery Timing" datatype="string" name="[delivery_timing]" role="dimension" type="nominal"/>
            <column caption="Delivery Timing Order" datatype="integer" name="[delivery_timing_order]" role="dimension" type="ordinal"/>
            <column caption="Freight Charges" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[freight_charges]" role="measure" type="quantitative"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
            <column caption="Is Repeat Customer" datatype="integer" name="[is_repeat_customer]" role="measure" type="quantitative"/>
            <column caption="Item Count" datatype="integer" name="[item_count]" role="measure" type="quantitative"/>
            <column caption="Merchandise Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[merchandise_sales]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Order Value" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[order_value]" role="measure" type="quantitative"/>
            <column caption="Purchase Date" datatype="date" name="[purchase_date]" role="dimension" type="ordinal"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Review Score" datatype="integer" name="[review_score]" role="measure" type="quantitative"/>
            <column caption="State" datatype="string" name="[state_label]" role="dimension" type="nominal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_late_rank]" role="dimension" type="ordinal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_sales_rank]" role="dimension" type="ordinal"/>
            <column-instance column="[customer_region]" derivation="Attribute" name="[attr:customer_region:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calc_Network_Late]" derivation="Min" name="[min:Calc_Network_Late:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[state_label]" derivation="None" name="[none:state_label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[state_late_rank]" derivation="None" name="[none:state_late_rank:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Action_Label]" derivation="User" name="[usr:Calc_Action_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calc_Avg_Review]" derivation="User" name="[usr:Calc_Avg_Review:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Excess_Late]" derivation="User" name="[usr:Calc_Excess_Late:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Gap_pp]" derivation="User" name="[usr:Calc_Gap_pp:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Late_Orders]" derivation="User" name="[usr:Calc_Late_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Late_Rate]" derivation="User" name="[usr:Calc_Late_Rate:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Late_Sales]" derivation="User" name="[usr:Calc_Late_Sales:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Orders]" derivation="User" name="[usr:Calc_Orders:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Tier]" derivation="User" name="[usr:Calc_Tier:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[Calc_Tier_Code]" derivation="User" name="[usr:Calc_Tier_Code:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <computed-sort column="[federated.olistorders].[none:state_label:nk]" direction="DESC" using="[federated.olistorders].[usr:Calc_Excess_Late:qk]"/>
          <filter class="quantitative" column="[federated.olistorders].[none:state_late_rank:qk]" included-values="in-range">
            <min>1</min>
            <max>99</max>
          </filter>
          <slices>
            <column>[federated.olistorders].[none:state_late_rank:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
            <format attr="font-size" value="9"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.olistorders].[usr:Calc_Excess_Late:qk]" scope="cols" value="Excess late orders"/>
            <encoding attr="space" class="0" field="[federated.olistorders].[usr:Calc_Excess_Late:qk]" field-type="quantitative" max="1617" min="-1617" range-type="fixed" scope="cols" type="space"/>
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.olistorders].[none:state_label:nk]" value="160"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Tier:ok]" value="62"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Orders:ok]" value="54"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Late_Rate:ok]" value="62"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Gap_pp:ok]" value="58"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Avg_Review:ok]" value="72"/>
            <format attr="width" field="[federated.olistorders].[usr:Calc_Late_Sales:ok]" value="100"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="on"/>
            <format attr="stroke-color" value="#8a97a6"/>
          </style-rule>
          <style-rule element="mark">
            <encoding attr="color" field="[federated.olistorders].[usr:Calc_Tier_Code:qk]" max="3" min="1" type="custom-interpolated">
              <color-palette custom="true" name="" type="ordered-sequential">
                <color>#3fc1e8</color>
                <color>#f2b84b</color>
                <color>#e8467c</color>
              </color-palette>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <color column="[federated.olistorders].[usr:Calc_Tier_Code:qk]"/>
              <text column="[federated.olistorders].[usr:Calc_Action_Label:nk]"/>
              <tooltip column="[federated.olistorders].[attr:customer_region:nk]"/>
              <tooltip column="[federated.olistorders].[usr:Calc_Late_Orders:qk]"/>
              <tooltip column="[federated.olistorders].[min:Calc_Network_Late:qk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">&lt;[federated.olistorders].[none:state_label:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Tier: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Tier:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Region: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[attr:customer_region:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Delivered orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Orders:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Late orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Late_Orders:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Late rate: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Late_Rate:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Network late rate: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[min:Calc_Network_Late:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Gap (pp): </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Gap_pp:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Excess late orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Excess_Late:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Avg review: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Avg_Review:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Sales on late orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistorders].[usr:Calc_Late_Sales:ok]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">Excess = late orders - delivered orders x network late rate</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#c3ccd6" fontsize="8">&lt;[federated.olistorders].[usr:Calc_Action_Label:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="size" value="0.45"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.olistorders].[none:state_label:nk] / [federated.olistorders].[usr:Calc_Tier:ok] / [federated.olistorders].[usr:Calc_Orders:ok] / [federated.olistorders].[usr:Calc_Late_Rate:ok] / [federated.olistorders].[usr:Calc_Gap_pp:ok] / [federated.olistorders].[usr:Calc_Avg_Review:ok] / [federated.olistorders].[usr:Calc_Late_Sales:ok])</rows>
        <cols>[federated.olistorders].[usr:Calc_Excess_Late:qk]</cols>
      </table>
      <simple-id uuid="{4CBA845C-7C34-5C0A-BC6D-5CC8F631AF00}"/>
    </worksheet>
    <worksheet name="Action State Trend">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">MONTHLY LATE RATE: SELECTED STATE</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">All 27 states until a row is selected in the queue (click again to clear)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Orders (delivered)" name="federated.olistorders"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistorders">
            <column caption="Action Label" datatype="string" name="[Calc_Action_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF([Calc_Excess_Late] &gt;= 0, &quot;+&quot;, &quot;&quot;) + STR(INT(ROUND([Calc_Excess_Late], 0)))"/>
            </column>
            <column caption="Avg Delivery Days" datatype="real" default-format="n0.0" name="[Calc_Avg_Days]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([delivery_days])"/>
            </column>
            <column caption="Avg Review" datatype="real" default-format="n0.00" name="[Calc_Avg_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Delta Late" datatype="string" name="[Calc_D_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% to &quot; + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Orders" datatype="string" name="[Calc_D_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) &gt;= COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) / COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Delta Review" datatype="string" name="[Calc_D_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END) &gt;= AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; to &quot; + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Sales" datatype="string" name="[Calc_D_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) / SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Excess Late Orders" datatype="real" default-format="n+#,##0;-#,##0" name="[Calc_Excess_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) - COUNT([is_late]) * MIN([Calc_Network_Late])"/>
            </column>
            <column caption="Gap (pp)" datatype="real" default-format="n+0.0;-0.0" name="[Calc_Gap_pp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="100 * ([Calc_Late_Rate] - MIN([Calc_Network_Late]))"/>
            </column>
            <column caption="KPI Avg Order Value" datatype="string" name="[Calc_KPI_AOV]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([order_value]) / COUNTD([order_id]), 2))"/>
            </column>
            <column caption="KPI Avg Delivery Days" datatype="string" name="[Calc_KPI_Days]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([delivery_days]), 1)) + &quot; days&quot;"/>
            </column>
            <column caption="KPI Freight Share" datatype="string" name="[Calc_KPI_Freight]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([freight_charges]) / SUM([order_value]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Late Delivery Rate" datatype="string" name="[Calc_KPI_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Orders" datatype="string" name="[Calc_KPI_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(COUNTD([order_id]) / 1000, 1)) + &quot;K&quot;"/>
            </column>
            <column caption="KPI Repeat Customers" datatype="string" name="[Calc_KPI_Repeat]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * COUNTD(IF [is_repeat_customer] = 1 THEN [customer_unique_id] END) / COUNTD([customer_unique_id]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Avg Review" datatype="string" name="[Calc_KPI_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; / 5&quot;"/>
            </column>
            <column caption="KPI Merchandise Sales" datatype="string" name="[Calc_KPI_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot;"/>
            </column>
            <column caption="Late Share (colour)" datatype="real" default-format="p0%" name="[Calc_Late_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([is_late])"/>
            </column>
            <column caption="Late Orders" datatype="integer" default-format="n#,##0" name="[Calc_Late_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late])"/>
            </column>
            <column caption="Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Late_Rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Late-order Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[Calc_Late_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [is_late] = 1 THEN [merchandise_sales] END)"/>
            </column>
            <column caption="Month Index" datatype="integer" name="[Calc_Month_Index]" role="measure" type="quantitative">
              <calculation class="tableau" formula="YEAR([purchase_month]) * 100 + MONTH([purchase_month])"/>
            </column>
            <column caption="Month" datatype="string" name="[Calc_Month_Label]" role="dimension" type="nominal">
              <calculation class="tableau" formula="LEFT(DATENAME('month', [purchase_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([purchase_month])), 2)"/>
            </column>
            <column caption="Network Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Network_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED : SUM([is_late]) / COUNT([is_late])}"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[Calc_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([order_id])"/>
            </column>
            <column caption="Delivery Outcome" datatype="string" name="[Calc_Outcome]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([is_late]) THEN &quot;Unknown&quot; ELSEIF [is_late] = 1 THEN &quot;Late&quot; ELSE &quot;On time or early&quot; END"/>
            </column>
            <column caption="Review Label" datatype="string" name="[Calc_Review_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; ★&quot;"/>
            </column>
            <column caption="Sales (R$M)" datatype="real" default-format="c&quot;R$&quot;#,##0.00&quot;M&quot;" name="[Calc_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([merchandise_sales]) / 1000000"/>
            </column>
            <column caption="State Late Label" datatype="string" name="[Calc_State_Late_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% · &quot; + IIF(COUNT([is_late]) &gt;= 1000, STR(ROUND(COUNT([is_late]) / 1000, 1)) + &quot;K&quot;, STR(COUNT([is_late]))) + &quot; orders&quot;"/>
            </column>
            <column caption="State Sales Label" datatype="string" name="[Calc_State_Sales_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot; + &quot; · &quot; + STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% late&quot;"/>
            </column>
            <column caption="Tier" datatype="string" name="[Calc_Tier]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF [Calc_Gap_pp] &gt;= 3 AND [Calc_Excess_Late] &gt;= 50 THEN &quot;Priority&quot; ELSEIF [Calc_Gap_pp] &gt;= 1 THEN &quot;Watch&quot; ELSE &quot;Monitor&quot; END"/>
            </column>
            <column caption="Priority Tier Code" datatype="integer" name="[Calc_Tier_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_Tier] = &quot;Priority&quot; THEN 3 ELSEIF [Calc_Tier] = &quot;Watch&quot; THEN 2 ELSE 1 END"/>
            </column>
            <column caption="Region" datatype="string" name="[customer_region]" role="dimension" type="nominal"/>
            <column caption="State Code" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Customer Unique ID" datatype="string" name="[customer_unique_id]" role="dimension" type="nominal"/>
            <column caption="Days vs Estimate" datatype="integer" name="[days_vs_estimate]" role="measure" type="quantitative"/>
            <column caption="Delivery Days" datatype="real" name="[delivery_days]" role="measure" type="quantitative"/>
            <column caption="Delivery Timing" datatype="string" name="[delivery_timing]" role="dimension" type="nominal"/>
            <column caption="Delivery Timing Order" datatype="integer" name="[delivery_timing_order]" role="dimension" type="ordinal"/>
            <column caption="Freight Charges" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[freight_charges]" role="measure" type="quantitative"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
            <column caption="Is Repeat Customer" datatype="integer" name="[is_repeat_customer]" role="measure" type="quantitative"/>
            <column caption="Item Count" datatype="integer" name="[item_count]" role="measure" type="quantitative"/>
            <column caption="Merchandise Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[merchandise_sales]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Order Value" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[order_value]" role="measure" type="quantitative"/>
            <column caption="Purchase Date" datatype="date" name="[purchase_date]" role="dimension" type="ordinal"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Review Score" datatype="integer" name="[review_score]" role="measure" type="quantitative"/>
            <column caption="State" datatype="string" name="[state_label]" role="dimension" type="nominal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_late_rank]" role="dimension" type="ordinal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_sales_rank]" role="dimension" type="ordinal"/>
            <column-instance column="[purchase_month]" derivation="None" name="[none:purchase_month:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Late_Orders]" derivation="User" name="[usr:Calc_Late_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Late_Rate]" derivation="User" name="[usr:Calc_Late_Rate:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Orders]" derivation="User" name="[usr:Calc_Orders:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.olistorders].[none:purchase_month:qk]" included-values="in-range">
            <min>#2017-01-01#</min>
            <max>#2018-08-01#</max>
          </filter>
          <slices>
            <column>[federated.olistorders].[none:purchase_month:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
