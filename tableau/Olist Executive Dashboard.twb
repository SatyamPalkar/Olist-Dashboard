    <worksheet name="Diag Retention">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">REPEAT RATE BY FIRST-ORDER DELIVERY</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">Customers whose first delivered order was before Mar 2018 (6+ months to reorder). Association, not cause.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Customers (delivered)" name="federated.olistcustomers"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistcustomers">
            <column caption="First Late (colour)" datatype="real" default-format="p0%" name="[CU_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([first_order_late])"/>
            </column>
            <column caption="Customers" datatype="integer" default-format="n#,##0" name="[CU_Customers]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([customer_unique_id])"/>
            </column>
            <column caption="First Order" datatype="string" name="[CU_First]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [first_order_late] = 1 THEN &quot;Late&quot; ELSE &quot;On time&quot; END"/>
            </column>
            <column caption="Retention Label" datatype="string" name="[CU_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * AVG([is_repeat]), 2)) + &quot;% · &quot; + STR(ROUND(COUNT([customer_unique_id]) / 1000, 1)) + &quot;K&quot;"/>
            </column>
            <column caption="Repeat Rate" datatype="real" default-format="p0.00%" name="[CU_Repeat]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([is_repeat])"/>
            </column>
            <column caption="Repeat Customers" datatype="integer" default-format="n#,##0" name="[CU_Repeaters]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_repeat])"/>
            </column>
            <column caption="Retention Cohort" datatype="integer" name="[CU_Valid]" role="dimension" type="quantitative">
              <calculation class="tableau" formula="IF NOT ISNULL([first_order_late]) AND [first_purchase_date] &lt; #2018-03-01# THEN 1 ELSE 0 END"/>
            </column>
            <column caption="Customer State" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Customer" datatype="string" name="[customer_unique_id]" role="dimension" type="nominal"/>
            <column caption="Delivered Orders" datatype="integer" name="[delivered_orders]" role="measure" type="quantitative"/>
            <column caption="First Order Late" datatype="integer" name="[first_order_late]" role="measure" type="quantitative"/>
            <column caption="First Purchase Date" datatype="date" name="[first_purchase_date]" role="dimension" type="ordinal"/>
            <column caption="First Purchase Month" datatype="date" name="[first_purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Is Repeat" datatype="integer" name="[is_repeat]" role="measure" type="quantitative"/>
            <column-instance column="[CU_First]" derivation="None" name="[none:CU_First:nk]" pivot="key" type="nominal"/>
            <column-instance column="[CU_Valid]" derivation="None" name="[none:CU_Valid:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[CU_Code]" derivation="User" name="[usr:CU_Code:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[CU_Customers]" derivation="User" name="[usr:CU_Customers:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[CU_Label]" derivation="User" name="[usr:CU_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[CU_Repeat]" derivation="User" name="[usr:CU_Repeat:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[CU_Repeaters]" derivation="User" name="[usr:CU_Repeaters:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.olistcustomers].[none:CU_Valid:qk]" included-values="in-range">
            <min>1</min>
            <max>1</max>
          </filter>
          <slices>
            <column>[federated.olistcustomers].[none:CU_Valid:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
            <format attr="font-size" value="9"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="cols" value="false"/>
            <format attr="display-field-labels" scope="rows" value="false"/>
          </style-rule>
