    <worksheet name="Top Categories">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">TOP CATEGORIES BY SALES</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">Top 10 = 62% of merchandise sales (label: sales · share)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order items (delivered)" name="federated.olistitems"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistitems">
            <column caption="Category Label" datatype="string" name="[Calc_Cat_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([price]) / 1000000, 2)) + &quot;M&quot; + &quot; · &quot; + STR(ROUND(100 * SUM([price]) / MIN({FIXED : SUM([price])}), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[Calc_Item_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([order_id])"/>
            </column>
            <column caption="Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[Calc_Item_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([price])"/>
            </column>
            <column caption="Share of Sales" datatype="real" default-format="p0.0%" name="[Calc_Item_Share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([price]) / MIN({FIXED : SUM([price])})"/>
            </column>
            <column caption="Category" datatype="string" name="[category]" role="dimension" type="nominal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[category_sales_rank]" role="dimension" type="ordinal"/>
            <column caption="Item Freight" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[freight_value]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Item Price" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[price]" role="measure" type="quantitative"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Seller State" datatype="string" name="[seller_state]" role="dimension" type="nominal"/>
            <column-instance column="[category]" derivation="None" name="[none:category:nk]" pivot="key" type="nominal"/>
            <column-instance column="[category_sales_rank]" derivation="None" name="[none:category_sales_rank:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[category_sales_rank]" derivation="None" name="[none:category_sales_rank:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[price]" derivation="Sum" name="[sum:price:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Cat_Label]" derivation="User" name="[usr:Calc_Cat_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calc_Item_Orders]" derivation="User" name="[usr:Calc_Item_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Item_Sales]" derivation="User" name="[usr:Calc_Item_Sales:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Item_Share]" derivation="User" name="[usr:Calc_Item_Share:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.olistitems].[none:category_sales_rank:qk]" included-values="in-range">
            <min>1</min>
            <max>10</max>
          </filter>
          <slices>
            <column>[federated.olistitems].[none:category_sales_rank:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="table">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="title">
            <format attr="background-color" value="#18222f"/>
          </style-rule>
          <style-rule element="label">
            <format attr="color" value="#c3ccd6"/>
            <format attr="font-size" value="9"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="zeroline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
          <style-rule element="table-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="header-div">
            <format attr="line-visibility" scope="cols" value="off"/>
            <format attr="line-visibility" scope="rows" value="off"/>
          </style-rule>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="cols" value="false"/>
            <format attr="display-field-labels" scope="rows" value="false"/>
          </style-rule>
          <style-rule element="axis">
            <format attr="display" class="0" field="[federated.olistitems].[sum:price:qk]" scope="cols" value="false"/>
            <encoding attr="space" class="0" field="[federated.olistitems].[sum:price:qk]" field-type="quantitative" max="2712889.783999944" min="0" range-type="fixed" scope="cols" type="space"/>
          </style-rule>
          <style-rule element="header">
            <format attr="width" field="[federated.olistitems].[none:category_sales_rank:ok]" value="24"/>
            <format attr="width" field="[federated.olistitems].[none:category:nk]" value="162"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <text column="[federated.olistitems].[usr:Calc_Cat_Label:nk]"/>
              <tooltip column="[federated.olistitems].[usr:Calc_Item_Sales:qk]"/>
              <tooltip column="[federated.olistitems].[usr:Calc_Item_Share:qk]"/>
              <tooltip column="[federated.olistitems].[usr:Calc_Item_Orders:qk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">&lt;[federated.olistitems].[none:category:nk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Sales: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistitems].[usr:Calc_Item_Sales:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Share of sales: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistitems].[usr:Calc_Item_Share:qk]&gt;</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="9">Orders: </run>
                <run bold="true" fontcolor="#16202b" fontsize="9">&lt;[federated.olistitems].[usr:Calc_Item_Orders:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor="#c3ccd6" fontsize="8">&lt;[federated.olistitems].[usr:Calc_Cat_Label:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-color" value="#c9d1da"/>
                <format attr="size" value="0.35"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.olistitems].[none:category_sales_rank:ok] / [federated.olistitems].[none:category:nk])</rows>
        <cols>[federated.olistitems].[sum:price:qk]</cols>
      </table>
      <simple-id uuid="{9C76BE4D-E68B-5929-8A32-2CA9C5D72DF8}"/>
    </worksheet>
    <worksheet name="Top States">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">TOP STATES BY SALES</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">SP = 38% of sales. RJ, the #2 market, is late on 13.5% of orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Orders (delivered)" name="federated.olistorders"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistorders">
            <column caption="Action Label" datatype="string" name="[Calc_Action_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF([Calc_Excess_Late] &gt;= 0, &quot;+&quot;, &quot;&quot;) + STR(INT(ROUND([Calc_Excess_Late], 0)))"/>
            </column>
            <column caption="Avg Delivery Days" datatype="real" default-format="n0.0" name="[Calc_Avg_Days]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([delivery_days])"/>
            </column>
            <column caption="Avg Review" datatype="real" default-format="n0.00" name="[Calc_Avg_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Delta Late" datatype="string" name="[Calc_D_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% to &quot; + STR(ROUND(100 * SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END) / COUNT(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [is_late] END), 1)) + &quot;% (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Orders" datatype="string" name="[Calc_D_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) &gt;= COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(COUNTD(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) / COUNTD(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [order_id] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Delta Review" datatype="string" name="[Calc_D_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END) &gt;= AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; to &quot; + STR(ROUND(AVG(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [review_score] END), 2)) + &quot; (Jan-Aug 17 to 18)&quot;"/>
            </column>
            <column caption="Delta Sales" datatype="string" name="[Calc_D_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) &gt;= SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END), &quot;▲ &quot;, &quot;▼ &quot;) + STR(INT(ROUND(100 * ABS(SUM(IF (YEAR([purchase_month]) = 2018 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) / SUM(IF (YEAR([purchase_month]) = 2017 AND MONTH([purchase_month]) &lt;= 8) THEN [merchandise_sales] END) - 1), 0))) + &quot;% Jan-Aug 2018 vs 2017&quot;"/>
            </column>
            <column caption="Excess Late Orders" datatype="real" default-format="n+#,##0;-#,##0" name="[Calc_Excess_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) - COUNT([is_late]) * MIN([Calc_Network_Late])"/>
            </column>
            <column caption="Gap (pp)" datatype="real" default-format="n+0.0;-0.0" name="[Calc_Gap_pp]" role="measure" type="quantitative">
              <calculation class="tableau" formula="100 * ([Calc_Late_Rate] - MIN([Calc_Network_Late]))"/>
            </column>
            <column caption="KPI Avg Order Value" datatype="string" name="[Calc_KPI_AOV]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([order_value]) / COUNTD([order_id]), 2))"/>
            </column>
            <column caption="KPI Avg Delivery Days" datatype="string" name="[Calc_KPI_Days]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([delivery_days]), 1)) + &quot; days&quot;"/>
            </column>
            <column caption="KPI Freight Share" datatype="string" name="[Calc_KPI_Freight]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([freight_charges]) / SUM([order_value]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Late Delivery Rate" datatype="string" name="[Calc_KPI_Late]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Orders" datatype="string" name="[Calc_KPI_Orders]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(COUNTD([order_id]) / 1000, 1)) + &quot;K&quot;"/>
            </column>
            <column caption="KPI Repeat Customers" datatype="string" name="[Calc_KPI_Repeat]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * COUNTD(IF [is_repeat_customer] = 1 THEN [customer_unique_id] END) / COUNTD([customer_unique_id]), 1)) + &quot;%&quot;"/>
            </column>
            <column caption="KPI Avg Review" datatype="string" name="[Calc_KPI_Review]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; / 5&quot;"/>
            </column>
            <column caption="KPI Merchandise Sales" datatype="string" name="[Calc_KPI_Sales]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot;"/>
            </column>
            <column caption="Late Share (colour)" datatype="real" default-format="p0%" name="[Calc_Late_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([is_late])"/>
            </column>
            <column caption="Late Orders" datatype="integer" default-format="n#,##0" name="[Calc_Late_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late])"/>
            </column>
            <column caption="Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Late_Rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Late-order Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[Calc_Late_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [is_late] = 1 THEN [merchandise_sales] END)"/>
            </column>
            <column caption="Month Index" datatype="integer" name="[Calc_Month_Index]" role="measure" type="quantitative">
              <calculation class="tableau" formula="YEAR([purchase_month]) * 100 + MONTH([purchase_month])"/>
            </column>
            <column caption="Month" datatype="string" name="[Calc_Month_Label]" role="dimension" type="nominal">
              <calculation class="tableau" formula="LEFT(DATENAME('month', [purchase_month]), 3) + &quot; &quot; + RIGHT(STR(YEAR([purchase_month])), 2)"/>
            </column>
            <column caption="Network Late Rate" datatype="real" default-format="p0.0%" name="[Calc_Network_Late]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED : SUM([is_late]) / COUNT([is_late])}"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[Calc_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNTD([order_id])"/>
            </column>
            <column caption="Delivery Outcome" datatype="string" name="[Calc_Outcome]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([is_late]) THEN &quot;Unknown&quot; ELSEIF [is_late] = 1 THEN &quot;Late&quot; ELSE &quot;On time or early&quot; END"/>
            </column>
            <column caption="Review Label" datatype="string" name="[Calc_Review_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(AVG([review_score]), 2)) + &quot; ★&quot;"/>
            </column>
            <column caption="Sales (R$M)" datatype="real" default-format="c&quot;R$&quot;#,##0.00&quot;M&quot;" name="[Calc_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([merchandise_sales]) / 1000000"/>
            </column>
            <column caption="State Late Label" datatype="string" name="[Calc_State_Late_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% · &quot; + IIF(COUNT([is_late]) &gt;= 1000, STR(ROUND(COUNT([is_late]) / 1000, 1)) + &quot;K&quot;, STR(COUNT([is_late]))) + &quot; orders&quot;"/>
            </column>
            <column caption="State Sales Label" datatype="string" name="[Calc_State_Sales_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="&quot;R$&quot; + STR(ROUND(SUM([merchandise_sales]) / 1000000, 2)) + &quot;M&quot; + &quot; · &quot; + STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% late&quot;"/>
            </column>
            <column caption="Tier" datatype="string" name="[Calc_Tier]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF [Calc_Gap_pp] &gt;= 3 AND [Calc_Excess_Late] &gt;= 50 THEN &quot;Priority&quot; ELSEIF [Calc_Gap_pp] &gt;= 1 THEN &quot;Watch&quot; ELSE &quot;Monitor&quot; END"/>
            </column>
            <column caption="Priority Tier Code" datatype="integer" name="[Calc_Tier_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calc_Tier] = &quot;Priority&quot; THEN 3 ELSEIF [Calc_Tier] = &quot;Watch&quot; THEN 2 ELSE 1 END"/>
            </column>
            <column caption="Region" datatype="string" name="[customer_region]" role="dimension" type="nominal"/>
            <column caption="State Code" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Customer Unique ID" datatype="string" name="[customer_unique_id]" role="dimension" type="nominal"/>
            <column caption="Days vs Estimate" datatype="integer" name="[days_vs_estimate]" role="measure" type="quantitative"/>
            <column caption="Delivery Days" datatype="real" name="[delivery_days]" role="measure" type="quantitative"/>
            <column caption="Delivery Timing" datatype="string" name="[delivery_timing]" role="dimension" type="nominal"/>
            <column caption="Delivery Timing Order" datatype="integer" name="[delivery_timing_order]" role="dimension" type="ordinal"/>
            <column caption="Freight Charges" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[freight_charges]" role="measure" type="quantitative"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
            <column caption="Is Repeat Customer" datatype="integer" name="[is_repeat_customer]" role="measure" type="quantitative"/>
            <column caption="Item Count" datatype="integer" name="[item_count]" role="measure" type="quantitative"/>
            <column caption="Merchandise Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[merchandise_sales]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Order Value" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[order_value]" role="measure" type="quantitative"/>
            <column caption="Purchase Date" datatype="date" name="[purchase_date]" role="dimension" type="ordinal"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Review Score" datatype="integer" name="[review_score]" role="measure" type="quantitative"/>
            <column caption="State" datatype="string" name="[state_label]" role="dimension" type="nominal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_late_rank]" role="dimension" type="ordinal"/>
            <column caption="#" datatype="integer" default-format="*00" name="[state_sales_rank]" role="dimension" type="ordinal"/>
            <column-instance column="[state_label]" derivation="None" name="[none:state_label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[state_sales_rank]" derivation="None" name="[none:state_sales_rank:ok]" pivot="key" type="ordinal"/>
            <column-instance column="[state_sales_rank]" derivation="None" name="[none:state_sales_rank:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[merchandise_sales]" derivation="Sum" name="[sum:merchandise_sales:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Avg_Review]" derivation="User" name="[usr:Calc_Avg_Review:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Late_Rate]" derivation="User" name="[usr:Calc_Late_Rate:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Orders]" derivation="User" name="[usr:Calc_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_Sales]" derivation="User" name="[usr:Calc_Sales:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calc_State_Sales_Label]" derivation="User" name="[usr:Calc_State_Sales_Label:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.olistorders].[none:state_sales_rank:qk]" included-values="in-range">
            <min>1</min>
            <max>10</max>
          </filter>
          <slices>
            <column>[federated.olistorders].[none:state_sales_rank:qk]</column>
          </slices>
          <aggregation value="true"/>
        </view>
