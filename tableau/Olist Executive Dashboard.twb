                <button action="tabdoc:goto-sheet window-id=&quot;{6CA5F50A-F933-5BF3-8781-E5AC90367C18}&quot;" button-type="text">
                  <button-visual-state>
                    <caption>ACTION QUEUE</caption>
                    <tooltip-text>Go to Action Queue</tooltip-text>
                    <button-caption-font-style bold="true" fontcolor="#0e1621" fontname="Tableau Medium" fontsize="9"/>
                    <format attr="background-color" value="#3fc1e8"/>
                    <format attr="border-style" value="none"/>
                  </button-visual-state>
                </button>
                <zone-style>
                  <format attr="border-style" value="none"/>
                  <format attr="border-width" value="0"/>
