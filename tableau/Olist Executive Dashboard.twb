              <text column="[federated.olistorders].[usr:Calc_KPI_Orders:nk]"/>
              <text column="[federated.olistorders].[usr:Calc_D_Orders:nk]"/>
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold="true" fontcolor="#16202b" fontsize="10">DELIVERED ORDERS</run>
                <run>Æ
</run>
                <run fontcolor="#5b6573" fontsize="8">Count of delivered orders, Sep 2016 - Aug 2018. Delta compares Jan-Aug 2018 with Jan-Aug 2017.</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold="true" fontcolor="#8a97a6" fontsize="9">DELIVERED ORDERS</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#f2f5f8" fontsize="24">&lt;[federated.olistorders].[usr:Calc_KPI_Orders:nk]&gt;</run>
