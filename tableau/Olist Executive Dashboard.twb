    </worksheet>
    <worksheet name="Ful Routes">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#f2f5f8" fontsize="10">LATE RATE BY ROUTE</run>
            <run>Æ
</run>
            <run fontcolor="#8a97a6" fontsize="8">Seller state → customer state, routes with 500+ seller-orders. Label: rate · volume</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order x seller (delivered)" name="federated.olistsellers"/>
          </datasources>
          <datasource-dependencies datasource="federated.olistsellers">
            <column caption="Dispatch (d)" datatype="real" default-format="n0.0" name="[S_Dispatch]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([dispatch_days])"/>
            </column>
            <column caption="Excess Late Orders" datatype="real" default-format="n+#,##0;-#,##0" name="[S_Excess]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) - COUNT([is_late]) * MIN([S_Network])"/>
            </column>
            <column caption="Excess Label" datatype="string" name="[S_Excess_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="IIF([S_Excess] &gt;= 0, &quot;+&quot;, &quot;&quot;) + STR(INT(ROUND([S_Excess], 0)))"/>
            </column>
            <column caption="Late Rate" datatype="real" default-format="p0.0%" name="[S_Late_Rate]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([is_late]) / COUNT([is_late])"/>
            </column>
            <column caption="Missed Limit" datatype="real" default-format="p0%" name="[S_Missed]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([missed_ship_limit])"/>
            </column>
            <column caption="Network Late Rate" datatype="real" default-format="p0.0%" name="[S_Network]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{FIXED : SUM([is_late]) / COUNT([is_late])}"/>
            </column>
            <column caption="Orders" datatype="integer" default-format="n#,##0" name="[S_Orders]" role="measure" type="quantitative">
              <calculation class="tableau" formula="COUNT([is_late])"/>
            </column>
            <column caption="Rate Label" datatype="string" name="[S_Rate_Label]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(100 * SUM([is_late]) / COUNT([is_late]), 1)) + &quot;% · &quot; + IIF(COUNT([is_late]) &gt;= 1000, STR(ROUND(COUNT([is_late]) / 1000, 1)) + &quot;K&quot;, STR(COUNT([is_late])))"/>
            </column>
            <column caption="Avg Review" datatype="real" default-format="n0.00" name="[S_Review]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([review_score])"/>
            </column>
            <column caption="Route Volume" datatype="integer" default-format="n#,##0" name="[S_Route_Size]" role="dimension" type="quantitative">
              <calculation class="tableau" formula="{FIXED [route] : COUNT([is_late])}"/>
            </column>
            <column caption="Seller Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[S_Sales]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([seller_sales])"/>
            </column>
            <column caption="Seller State Volume" datatype="integer" default-format="n#,##0" name="[S_State_Size]" role="dimension" type="quantitative">
              <calculation class="tableau" formula="{FIXED [seller_state] : COUNT([is_late])}"/>
            </column>
            <column caption="Transit (d)" datatype="real" default-format="n0.0" name="[S_Transit]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([transit_days])"/>
            </column>
            <column caption="Vs Network Code" datatype="integer" name="[S_Vs_Code]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IIF([S_Late_Rate] &gt; MIN([S_Network]), 1, 0)"/>
            </column>
            <column caption="Customer State" datatype="string" name="[customer_state]" role="dimension" type="nominal"/>
            <column caption="Seller Dispatch Days" datatype="real" default-format="n0.0" name="[dispatch_days]" role="measure" type="quantitative"/>
            <column caption="Is Late" datatype="integer" name="[is_late]" role="measure" type="quantitative"/>
            <column caption="Item Lines" datatype="integer" name="[item_lines]" role="measure" type="quantitative"/>
            <column caption="Missed Shipping Limit" datatype="integer" name="[missed_ship_limit]" role="measure" type="quantitative"/>
            <column caption="Order ID" datatype="string" name="[order_id]" role="dimension" type="nominal"/>
            <column caption="Purchase Month" datatype="date" name="[purchase_month]" role="dimension" type="ordinal"/>
            <column caption="Review Score" datatype="integer" name="[review_score]" role="measure" type="quantitative"/>
            <column caption="Route" datatype="string" name="[route]" role="dimension" type="nominal"/>
            <column caption="Sellers in Order" datatype="integer" name="[seller_count]" role="measure" type="quantitative"/>
            <column caption="Seller Excess Rank" datatype="integer" name="[seller_excess_rank]" role="dimension" type="quantitative"/>
            <column caption="Seller ID" datatype="string" name="[seller_id]" role="dimension" type="nominal"/>
            <column caption="Seller Sales" datatype="real" default-format="c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0" name="[seller_sales]" role="measure" type="quantitative"/>
            <column caption="Seller" datatype="string" name="[seller_short]" role="dimension" type="nominal"/>
            <column caption="State" datatype="string" name="[seller_state]" role="dimension" type="nominal"/>
            <column caption="Timing Valid" datatype="integer" name="[timing_valid]" role="dimension" type="quantitative"/>
            <column caption="Carrier Transit Days" datatype="real" default-format="n0.0" name="[transit_days]" role="measure" type="quantitative"/>
            <column-instance column="[S_Network]" derivation="Min" name="[min:S_Network:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Route_Size]" derivation="None" name="[none:S_Route_Size:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[route]" derivation="None" name="[none:route:nk]" pivot="key" type="nominal"/>
            <column-instance column="[S_Excess]" derivation="User" name="[usr:S_Excess:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Late_Rate]" derivation="User" name="[usr:S_Late_Rate:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Missed]" derivation="User" name="[usr:S_Missed:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Orders]" derivation="User" name="[usr:S_Orders:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Rate_Label]" derivation="User" name="[usr:S_Rate_Label:nk]" pivot="key" type="nominal"/>
            <column-instance column="[S_Transit]" derivation="User" name="[usr:S_Transit:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[S_Vs_Code]" derivation="User" name="[usr:S_Vs_Code:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <computed-sort column="[federated.olistsellers].[none:route:nk]" direction="DESC" using="[federated.olistsellers].[usr:S_Late_Rate:qk]"/>
          <filter class="quantitative" column="[federated.olistsellers].[none:S_Route_Size:qk]" included-values="in-range">
            <min>500</min>
            <max>10000000</max>
          </filter>
          <slices>
